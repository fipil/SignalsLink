<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Lib\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Lib\protobuf-net.dll</HintPath>
    </Reference>
    <Reference Include="signals">
      <HintPath>..\dependencies\signals.dll</HintPath>
    </Reference>
    <Reference Include="VintagestoryAPI">
      <HintPath>..\..\..\..\..\VintageStory\1.22\VintagestoryAPI.dll</HintPath>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>..\..\..\..\..\VintageStory\1.22\VintagestoryLib.dll</HintPath>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Mods\VSEssentials.dll</HintPath>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Mods\VSSurvivalMod.dll</HintPath>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Lib\OpenTK.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Lib\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Signals Tubes and SignalsLink are mods of their own; their DLLs must not be copied next to this one. -->
  <ItemGroup>
    <ProjectReference Include="..\SignalsTubes\SignalsTubes.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="..\SignalsLink\SignalsLink.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="assets\signalsmachines\blocktypes\" />
    <Folder Include="assets\signalsmachines\lang\" />
    <Folder Include="assets\signalsmachines\itemtypes\" />
    <Folder Include="assets\signalsmachines\recipes\" />
    <Folder Include="assets\signalsmachines\sounds\" />
    <Folder Include="assets\signalsmachines\textures\" />
    <Folder Include="assets\signalsmachines\shapes\block\" />
    <Folder Include="docs\" />
  </ItemGroup>

  <Target Name="PostBuild" BeforeTargets="PostBuildEvent" Condition="'$(SkipModPublish)' != 'true'">
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;c:\Develope\VintageStory\Projects\SignalsLink\Publish\&quot;" />
    <Exec Command="copy &quot;$(TargetDir)\$(TargetName).pdb&quot; &quot;c:\Develope\VintageStory\Projects\SignalsLink\Publish\&quot;" />
  </Target>

</Project>
