<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    NOTE: there is deliberately NO reference to yangtransport.dll anywhere in this project, and
    there must never be one. Everything that touches YTT goes through reflection, behind a probe
    that checks the surface it expects is still there, so that a YTT update can be survived rather
    than crashed into. See manageddock-design.md.
  -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Lib\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Lib\protobuf-net.dll</HintPath>
    </Reference>
    <Reference Include="VintagestoryAPI">
      <HintPath>..\..\..\..\..\VintageStory\1.22\VintagestoryAPI.dll</HintPath>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>..\..\..\..\..\VintageStory\1.22\VintagestoryLib.dll</HintPath>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Mods\VSEssentials.dll</HintPath>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>..\..\..\..\..\VintageStory\1.22\Mods\VSSurvivalMod.dll</HintPath>
    </Reference>
    <Reference Include="signals">
      <HintPath>..\dependencies\signals.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!--
    SignalsLink is referenced as a project so that building this one builds it first, but its DLL
    is NOT copied into the output: it is a mod of its own and the game loads it itself. Two copies
    of the same assembly in the mods folder is how you get two of every registry.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SignalsLink\SignalsLink.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="PostBuild" BeforeTargets="PostBuildEvent">
    <Exec ContinueOnError="true" Command="copy &quot;$(TargetPath)&quot; &quot;c:\Develope\VintageStory\Projects\SignalsLink\Publish\&quot;" />
    <Exec ContinueOnError="true" Command="copy &quot;$(TargetDir)\$(TargetName).pdb&quot; &quot;c:\Develope\VintageStory\Projects\SignalsLink\Publish\&quot;" />
  </Target>

</Project>
